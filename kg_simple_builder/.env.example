# Copy to .env and fill in. `sh setup.sh` does the copy for you.

# Name prefix for containers and volumes. On a shared server, make it unique per person, e.g. kgb-<yourname>.
KG_STACK_NAME=kgb

# Upstream LLM Graph Builder version. setup.sh checks out this tag.
KG_UPSTREAM_TAG=v0.8.7

# --- Ollama (no API keys) ---
# server: the shared Ollama server, e.g. http://<ollama-host>:<port>
# laptop: your local Ollama, from inside a container: http://host.docker.internal:11434
KG_OLLAMA_URL=http://host.docker.internal:11434
# Must be a model that is already pulled on that server.
# Pick one that supports tool calling, or extraction can fail (see README).
KG_OLLAMA_MODEL=

# --- Neo4j for this stack (separate from the main application Neo4j) ---
KG_NEO4J_PASSWORD=

# --- Ports on the host ---
KG_NEO4J_HTTP_PORT=
KG_NEO4J_BOLT_PORT=
KG_BACKEND_PORT=8000
KG_FRONTEND_PORT=8080

# URL the BROWSER uses to reach the backend.
# laptop: http://localhost:<KG_BACKEND_PORT>
KG_BACKEND_PUBLIC_URL=http://localhost:8000

# Backend workers and request timeout (seconds). Long files need a long timeout.
KG_BACKEND_WORKERS=2
KG_BACKEND_TIMEOUT=1800
